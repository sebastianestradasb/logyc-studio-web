---
import { social, ui, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  // "footer": icon + handle. "cta": a short invitation line under the closing call to action.
  variant: 'footer' | 'cta';
}
const { lang, variant } = Astro.props;
const t = ui[lang];
---
{variant === 'cta' ? (
  <div class="cta-social fx">
    <span>{t.followUs}</span>
    <a class="ig-link" href={social.instagram.url} target="_blank" rel="noopener" aria-label={t.instagramLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" class="ig-dot" /></svg>
      {social.instagram.handle}
    </a>
  </div>
) : (
  <a class="ig-link" href={social.instagram.url} target="_blank" rel="noopener" aria-label={t.instagramLabel}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1.1" class="ig-dot" /></svg>
    {social.instagram.handle}
  </a>
)}
