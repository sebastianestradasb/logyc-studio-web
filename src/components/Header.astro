---
import Logo from './Logo.astro';
import ShinyButton from './ui/shiny-button';
import Velaris from './ui/velaris';
import { routes, ui, type Lang, type Page } from '../i18n';

interface Props {
  lang: Lang;
  page: Page;
}
const { lang, page } = Astro.props;
const t = ui[lang];
const home = routes.home[lang];
const onHome = page === 'home';
const links = [
  { href: routes.web[lang], label: t.nav.web, current: page === 'web' },
  { href: routes.content[lang], label: t.nav.contenido, current: page === 'content' },
  { href: routes.process[lang], label: t.nav.proceso, current: page === 'process' },
  { href: routes.contact[lang], label: t.nav.contacto, current: page === 'contact' },
];
// The mobile menu also lists the home page, so every page has an entry to light up.
const mobileLinks = [{ href: onHome ? '#top' : home, label: t.nav.home, current: onHome }, ...links];
const contactPage = routes.contact[lang];
const current = (on: boolean) => (on ? 'page' : undefined);
---
<header id="hdr">
  <div class="wrap nav">
    <a href={onHome ? '#top' : home} class="logo" aria-label={t.homeLabel}>
      <Logo />
    </a>
    <div class="nav-right">
      <nav class="nav-links">
        {links.map((l) => <a href={l.href} aria-current={current(!!l.current)}>{l.label}</a>)}
      </nav>
      <ShinyButton href={contactPage} label={`${t.cta} →`} className="nav-cta" />
      <button class="sound-toggle is-on" type="button" data-sound-toggle aria-pressed="true"
        data-label-on={lang === 'es' ? 'Sonido activado' : 'Sound on'}
        data-label-off={lang === 'es' ? 'Sonido apagado' : 'Sound off'}
        aria-label={lang === 'es' ? 'Sonido activado' : 'Sound on'}>
        <span></span><span></span><span></span><span></span>
      </button>
      <div class="lang-switch">
        <a href={routes[page].es} class={lang === 'es' ? 'active' : undefined} aria-current={current(lang === 'es')}>ES</a>
        <span class="sep">/</span>
        <a href={routes[page].en} class={lang === 'en' ? 'active' : undefined} aria-current={current(lang === 'en')}>EN</a>
      </div>
      <button class="burger" id="burger" aria-label={t.menu} aria-expanded="false" aria-controls="mobileMenu"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
<!-- Full-screen mobile menu over the animated LOGYC-green gradient; the header stays on top of it,
     so the logo sits centred and the burger turns into the close button. -->
<div class="mobile-menu" id="mobileMenu" aria-hidden="true">
  <Velaris
    client:media="(max-width: 900px)"
    className="mm-bg"
    height="100%"
    bg="#0A0A0A"
    colors={["#1F3A06", "#AFFC30", "#4E7A0E", "#0A0A0A"]}
    speed={1.6}
    grain={0.35}
  />
  <nav class="mm-links" aria-label={t.menu}>
    {mobileLinks.map((l, i) => (
      <a href={l.href} aria-current={current(!!l.current)} style={`--i:${i}`}>
        <span class="mm-num">{String(i + 1).padStart(2, '0')}</span>
        <span class="mm-label">{l.label}</span>
      </a>
    ))}
  </nav>
  <div class="mm-foot" style={`--i:${mobileLinks.length}`}>
    <ShinyButton href={contactPage} label={`${t.cta} →`} className="mobile-cta" />
  </div>
</div>
