---
import Base from '../layouts/Base.astro';
import HeroGradient from '../components/HeroGradient.astro';
import Instagram from '../components/Instagram.astro';
import Reel from '../components/Reel.astro';
import MetroHero from '../components/ui/scroll-locked-video-hero';
import ScrollWordReveal from '../components/react/ScrollWordReveal';
import StackedSteps from '../components/react/StackedSteps';
import WhyBento from '../components/react/WhyBento';
---
<Base lang="en" page="home" title="LOGYC STUDIO — Web Design + AI Content">
<!-- HERO -->
<section class="hero hero-video" id="top">
  <MetroHero client:load videoSrc="/video/hero-city.mp4" posterSrc="/img/hero-city-poster.jpg" tagline="For brands that want to look like the future." scrollHint="SCROLL" signature={false}>
  <div slot="title" class="wrap hero-inner">
    <div class="hero-eyebrow"><span class="eyebrow"><span class="bk">[</span> WEB + AI CONTENT <span class="bk">]</span></span></div>
    <h1>
      <span class="reveal-line"><span style="animation-delay:.35s">Websites that convert.</span></span>
      <span class="reveal-line"><span class="lime" style="animation-delay:.5s">Content that sells.</span></span>
    </h1>
    <p class="sub">
      <span class="sub-line">We design modern, distinctive websites built to sell.</span>
      <span class="sub-line">We produce your content with AI: the future of visual production, today.</span>
      <span class="sub-line sub-key">Fast, premium, and with the human judgment that separates great from generic.</span>
    </p>
    <div class="cta-row">
      <a href="contacto-en.html" class="btn btn-primary">I want my website <span class="arw">→</span></a>
      <a href="web-en.html" class="btn btn-ghost">View web packages</a>
    </div>
  </div>
  </MetroHero>
</section>

<!-- INTRO / SERVICIOS -->
<section class="block" id="servicios">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="eyebrow"><span class="bk">[</span> WHAT WE DO <span class="bk">]</span></span>
    </div>
    <div class="intro-grid">
      <div class="fx">
        <h2 class="sec-title"><ScrollWordReveal client:visible parts={[{"text": "One studio for everything your brand needs to"}, {"text": "look good.", "lime": true}]} /></h2>
        <p class="lead">We combine artificial intelligence and design to produce professional-grade content and websites at a fraction of the traditional cost and time. You tell us what you need, we produce it.</p>
      </div>
      <div class="fx">
        <div class="service-list">
          <a href="#web">
            <span class="sl-idx">01</span>
            <span class="sl-name">Web Pages</span>
            <span class="arw">→</span>
          </a>
          <a href="#contenido">
            <span class="sl-idx">02</span>
            <span class="sl-name">AI Content</span>
            <span class="arw">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICIO 01 -->
<section class="svc" id="web">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="sec-num">[ 01 ]</span>
      <span class="eyebrow"><span class="bk">/</span> WEB DESIGN</span>
    </div>
    <div class="svc-top">
      <div class="svc-body fx">
        <h3>Websites that look good<br>and do their job.</h3>
        <p class="d">We design and build modern, fast pages made to convert. From a landing page for your campaign to your brand's full website — mobile-optimized, SEO-ready, and aligned with your identity.</p>
        <ul class="feat">
          <li>Custom design, aligned with your brand</li>
          <li>100% responsive: mobile, tablet, and desktop</li>
          <li>Speed and structure optimized for SEO</li>
          <li>Integration with social media, WhatsApp, and forms</li>
          <li>Built to grow: bilingual, e-commerce, and more</li>
        </ul>
        <a href="web-en.html" class="btn btn-primary svc-cta">View packages & pricing <span class="arw">→</span></a>
      </div>
      <!-- Live preview of a real project (Precision Garage): both screens scroll on their own or by hand -->
      <div class="svc-showcase fx">
        <div class="case-stage">
          <div class="browser">
            <div class="browser-bar"><i></i><i></i><i></i><span class="browser-url">https://<b>precisiongarage.com.co</b></span></div>
            <div class="browser-screen autoscroll" data-speed="70" tabindex="0" aria-label="Desktop view of the Precision Garage website">
              <img src="/img/portfolio/precision-garage-desktop.jpg" width="1100" height="6316" loading="lazy" alt="Desktop view of the Precision Garage website">
            </div>
          </div>
          <div class="phone">
            <div class="phone-screen autoscroll" data-speed="45" tabindex="0" aria-label="Mobile view of the Precision Garage website">
              <img src="/img/portfolio/precision-garage-mobile.jpg" width="600" height="7200" loading="lazy" alt="Mobile view of the Precision Garage website">
            </div>
          </div>
        </div>
        <div class="showcase-foot">
          <div class="case-hint"><span class="dot"></span>Scroll inside the screen to explore the site</div>
          <a href="https://precisiongarage.com.co/" target="_blank" rel="noopener" class="showcase-live">See Precision Garage live <span class="arw">↗</span></a>
        </div>
      </div>
    </div>

    <div class="types">
      <div class="type fx"><div class="k">Landing page</div><h4>One goal,<br>zero distractions.</h4><p>A page focused on capturing leads, selling a product, or presenting a campaign.</p></div>
      <div class="type fx"><div class="k">Brand website</div><h4>Your full<br>presence.</h4><p>Home, services, portfolio, and contact. The official face of your business online.</p></div>
      <div class="type fx"><div class="k">Store · E-commerce</div><h4>Ready<br>to sell.</h4><p>A site with catalog, cart, and payments, built to convert visits into sales.</p></div>
    </div>
  </div>
</section>

<!-- SERVICIO 02 -->
<section class="svc" id="contenido">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="sec-num">[ 02 ]</span>
      <span class="eyebrow"><span class="bk">/</span> AI CONTENT</span>
    </div>
    <div class="svc-top">
      <div class="svc-visual has-reel fx" id="visual1">
        <span class="bracket l">[</span><span class="bracket r">]</span>
        <div class="pixel-orbit" id="orbit1"></div>
        <Reel lang="en" />
      </div>
      <div class="svc-body fx">
        <h3>Professional image and video,<br>no photo shoot required.</h3>
        <p class="d">We produce product photos, social content, and video for your brand with cutting-edge AI. Studio quality, with the lighting, angles, and style your brand needs — no shoots, no locations, no waiting weeks.</p>
        <ul class="feat">
          <li>Product photography in multiple angles and settings</li>
          <li>Social content in vertical, square, and horizontal formats</li>
          <li>Short video for reels, ads, and campaigns</li>
          <li>High resolution with legible logos in every piece</li>
          <li>Revision rounds defined from the start</li>
        </ul>
        <a href="contenido-en.html" class="btn btn-primary svc-cta">See AI content <span class="arw">→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- WHY -->
<section class="block why">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="eyebrow"><span class="bk">[</span> WHY LOGYC <span class="bk">]</span></span>
    </div>
    <h2 class="sec-title fx"><ScrollWordReveal client:visible parts={[{"text": "We're not a traditional agency. And that's an"}, {"text": "advantage.", "lime": true}]} /></h2>
    <WhyBento client:visible copy={{"speed": {"title": "Speed", "text": "We deliver in days what others take months to do. AI does the heavy lifting; we bring the judgment.", "tradLabel": "Traditional production", "tradValue": "weeks or months", "logycValue": "3–10 business days"}, "quality": {"title": "Quality", "text": "Every piece goes through human direction. Technology is the tool, not the shortcut.", "steps": ["AI generates", "Human direction", "Final piece"]}, "price": {"title": "Fair pricing", "text": "Lower production costs mean better prices for you — without sacrificing the result.", "cut": ["Photo shoot", "Location", "Weeks of waiting"], "result": "Better prices for you"}, "consistency": {"title": "Consistency", "text": "Content and web that speak the same visual language: your brand's.", "post": "POST", "web": "YOUR WEBSITE", "legend": "Same colors · same type · same voice"}}} />
  </div>
</section>

<!-- PROCESS -->
<section class="block proc" id="proceso">
  <div class="wrap">
    <div class="proc-stage">
    <div class="proc-pin">
      <div class="sec-head fx">
        <span class="eyebrow"><span class="bk">[</span> HOW WE WORK <span class="bk">]</span></span>
      </div>
      <h2 class="sec-title fx">Simple, clear, and <span class="lime">straight to the point.</span></h2>
    </div>
    <StackedSteps client:visible steps={[{"title": "We talk", "text": "You tell us what you need and where your brand is headed."}, {"title": "We quote", "text": "We send you a clear proposal, with defined scope and timeline."}, {"title": "We produce", "text": "We create, you review within the agreed rounds."}, {"title": "We deliver", "text": "You receive everything ready to use and go live."}]} top="var(--stack-top, 96px)" />
    </div>
    <div class="proc-more fx"><a href="proceso-en.html" class="btn btn-primary">See the full process <span class="arw">→</span></a></div>
  </div>
</section>

<!-- FAQ -->
<section class="block faq" id="faq">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="eyebrow"><span class="bk">[</span> FREQUENTLY ASKED QUESTIONS <span class="bk">]</span></span>
    </div>
    <h2 class="sec-title fx">What everyone <span class="lime">asks.</span></h2>
    <div class="acc" id="acc">
      <div class="acc-item"><button class="acc-q">What services do you offer? <span class="ico">+</span></button><div class="acc-a"><p>Two: website design and AI content (product photography, social media content, and short video). You can hire them separately or together.</p></div></div>
      <div class="acc-item"><button class="acc-q">How much does a website cost? <span class="ico">+</span></button><div class="acc-a"><p>We have two fixed-price packages: Landing for $1,500,000 COP and Professional for $2,500,000 COP. Both include the first year of your domain, mobile-ready design, local SEO, and a WhatsApp button. <a href="web-en.html#paquetes">See web packages</a>.</p></div></div>
      <div class="acc-item"><button class="acc-q">How long until my website is ready? <span class="ico">+</span></button><div class="acc-a"><p>The Landing plan is delivered in 3 to 5 business days and the Professional plan in 7 to 10 business days.</p></div></div>
      <div class="acc-item"><button class="acc-q">Does AI content look real? <span class="ico">+</span></button><div class="acc-a"><p>Yes. We work with the best tools on the market, and every piece goes through human direction and refinement. The goal is for it to look professional, not artificial. <a href="contenido-en.html#portafolio">See our portfolio</a>.</p></div></div>
      <div class="acc-item"><button class="acc-q">How much does AI content cost? <span class="ico">+</span></button><div class="acc-a"><p>It is quoted to fit the volume of pieces and formats you need. We have three packages: Essential, Professional, and Premium. <a href="contenido-en.html#paquetes">See content packages</a>.</p></div></div>
      <div class="acc-item"><button class="acc-q">How many revisions do I get? <span class="ico">+</span></button><div class="acc-a"><p>For websites, 1 round of changes on Landing and 2 on Professional. For AI content, 1 round on Essential, 2 on Professional, and 3 on Premium. Always defined from the start.</p></div></div>
      <div class="acc-item"><button class="acc-q">How do I pay for a website? <span class="ico">+</span></button><div class="acc-a"><p>In two equal parts by bank transfer: 50% before we start and 50% at delivery.</p></div></div>
      <div class="acc-item"><button class="acc-q">Can I order just content or just the website? <span class="ico">+</span></button><div class="acc-a"><p>Of course. Each service works on its own, though they perform better together: both web plans already include AI-made photos of your business.</p></div></div>
      <div class="acc-item"><button class="acc-q">Do you work with brands outside Colombia? <span class="ico">+</span></button><div class="acc-a"><p>Yes. We work remotely and can deliver content and websites in Spanish and English.</p></div></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta cta-gradient" id="contacto">
  <HeroGradient />
  <div class="wrap">
    <span class="eyebrow fx" style="margin-bottom:26px;display:inline-flex"><span class="bk">[</span> LET'S START <span class="bk">]</span></span>
    <h2 class="fx">Ready to look<br>like the <span class="lime">future?</span></h2>
    <p class="fx">Tell us about your project and we'll send you a no-obligation quote.</p>
    <div class="cta-row fx">
      <a href="contacto-en.html" class="btn btn-primary">Start now <span class="arw">→</span></a>
      <a href="#" class="btn btn-ghost">Message us on WhatsApp</a>
    </div>
    <Instagram lang="en" variant="cta" />
  </div>
</section>
</Base>
