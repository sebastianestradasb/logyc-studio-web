---
import Base from '../layouts/Base.astro';
import Instagram from '../components/Instagram.astro';
import Reel from '../components/Reel.astro';
import AiPortfolio from '../components/AiPortfolio.astro';
import HeroBackground from '../components/react/HeroBackground';
import ScrollWordReveal from '../components/react/ScrollWordReveal';
import StackedSteps from '../components/react/StackedSteps';
import WhyBento from '../components/react/WhyBento';
import { ContainerScroll } from '../components/ui/container-scroll-animation';
---
<Base lang="en" page="home" title="LOGYC STUDIO — Web Design + AI Content">
<!-- HERO -->
<section class="hero" id="top">
  <HeroBackground client:load />
  <div class="hero-glow" id="heroGlow"></div>
  <div class="wrap hero-inner">
    <div class="hero-eyebrow"><span class="eyebrow"><span class="bk">[</span> WEB DESIGN + AI CONTENT <span class="bk">]</span></span></div>
    <h1>
      <span class="reveal-line"><span style="animation-delay:.35s">Websites that convert.</span></span>
      <span class="reveal-line"><span class="lime" style="animation-delay:.5s">Ready in days.</span></span>
    </h1>
    <p class="sub">We design modern, fast websites that showcase what you do and turn visitors into clients. And with AI, we create the photos and videos that make your brand look the part.</p>
    <div class="cta-row">
      <a href="contacto-en.html" class="btn btn-primary">I want my website <span class="arw">→</span></a>
      <a href="web-en.html" class="btn btn-ghost">View web packages</a>
    </div>
  </div>
  <div class="scroll-hint"><span>Scroll</span><span class="bar"></span></div>
</section>

<!-- MARQUEE -->
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">
    <span><b>PRODUCT PHOTOGRAPHY</b> <i class="dot"></i> <b>AI VIDEO</b> <i class="dot"></i> <b>SOCIAL CONTENT</b> <i class="dot"></i> <b>LANDING PAGES</b> <i class="dot"></i> <b>BRAND WEBSITES</b> <i class="dot"></i> <b>E-COMMERCE</b> <i class="dot"></i></span>
    <span><b>PRODUCT PHOTOGRAPHY</b> <i class="dot"></i> <b>AI VIDEO</b> <i class="dot"></i> <b>SOCIAL CONTENT</b> <i class="dot"></i> <b>LANDING PAGES</b> <i class="dot"></i> <b>BRAND WEBSITES</b> <i class="dot"></i> <b>E-COMMERCE</b> <i class="dot"></i></span>
  </div>
</div>

<!-- SHOWCASE -->
<section class="showcase">
  <ContainerScroll client:load>
    <div slot="titleComponent" class="showcase-head">
      <span class="eyebrow"><span class="bk">[</span> REAL WORK <span class="bk">]</span></span>
      <h2 class="sec-title">This is what we <span class="lime">build.</span></h2>
    </div>
    <img src="/img/portfolio/precision-garage-desktop.jpg" width="1100" height="6316" alt="Precision Garage website designed by LOGYC" class="showcase-shot" draggable="false">
  </ContainerScroll>
  <div class="showcase-link"><a href="#portafolio" class="btn btn-ghost">See the full case study <span class="arw">↓</span></a></div>
</section>

<!-- INTRO / SERVICIOS -->
<section class="block" id="servicios">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="eyebrow"><span class="bk">[</span> WHAT WE DO <span class="bk">]</span></span>
    </div>
    <div class="intro-grid">
      <div class="fx">
        <h2 class="sec-title"><ScrollWordReveal client:visible parts={[{"text": "One studio for everything your brand needs to"}, {"text": "look good.", "lime": true}]} /></h2>
        <p class="lead">We combine artificial intelligence and design to produce professional-grade content and websites at a fraction of the traditional cost and time. You tell us what you need, we produce it.</p>
      </div>
      <div class="fx">
        <div class="service-list">
          <a href="#web">
            <span class="sl-idx">01</span>
            <span class="sl-name">Web Pages</span>
            <span class="arw">→</span>
          </a>
          <a href="#contenido">
            <span class="sl-idx">02</span>
            <span class="sl-name">AI Content</span>
            <span class="arw">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SERVICIO 01 -->
<section class="svc" id="web">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="sec-num">[ 01 ]</span>
      <span class="eyebrow"><span class="bk">/</span> WEB DESIGN</span>
    </div>
    <div class="svc-top">
      <div class="svc-body fx">
        <h3>Websites that look good<br>and do their job.</h3>
        <p class="d">We design and build modern, fast pages made to convert. From a landing page for your campaign to your brand's full website — mobile-optimized, SEO-ready, and aligned with your identity.</p>
        <ul class="feat">
          <li>Custom design, aligned with your brand</li>
          <li>100% responsive: mobile, tablet, and desktop</li>
          <li>Speed and structure optimized for SEO</li>
          <li>Integration with social media, WhatsApp, and forms</li>
          <li>Built to grow: bilingual, e-commerce, and more</li>
        </ul>
        <a href="web-en.html" class="btn btn-primary svc-cta">View packages & pricing <span class="arw">→</span></a>
      </div>
      <div class="svc-visual fx" id="visual2">
        <span class="bracket l">[</span><span class="bracket r">]</span>
        <div class="pixel-orbit" id="orbit2"></div>
        <div class="core">
          <div class="big">WEB</div>
          <div class="lbl">design + development</div>
        </div>
      </div>
    </div>

    <div class="types">
      <div class="type fx"><div class="k">Landing page</div><h4>One goal,<br>zero distractions.</h4><p>A page focused on capturing leads, selling a product, or presenting a campaign.</p></div>
      <div class="type fx"><div class="k">Brand website</div><h4>Your full<br>presence.</h4><p>Home, services, portfolio, and contact. The official face of your business online.</p></div>
      <div class="type fx"><div class="k">Store · E-commerce</div><h4>Ready<br>to sell.</h4><p>A site with catalog, cart, and payments, built to convert visits into sales.</p></div>
    </div>
  </div>
</section>

<!-- SERVICIO 02 -->
<section class="svc" id="contenido">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="sec-num">[ 02 ]</span>
      <span class="eyebrow"><span class="bk">/</span> AI CONTENT</span>
    </div>
    <div class="svc-top">
      <div class="svc-visual has-reel fx" id="visual1">
        <span class="bracket l">[</span><span class="bracket r">]</span>
        <div class="pixel-orbit" id="orbit1"></div>
        <Reel lang="en" />
      </div>
      <div class="svc-body fx">
        <h3>Professional image and video,<br>no photo shoot required.</h3>
        <p class="d">We produce product photos, social content, and video for your brand with cutting-edge AI. Studio quality, with the lighting, angles, and style your brand needs — no shoots, no locations, no waiting weeks.</p>
        <ul class="feat">
          <li>Product photography in multiple angles and settings</li>
          <li>Social content in vertical, square, and horizontal formats</li>
          <li>Short video for reels, ads, and campaigns</li>
          <li>High resolution with legible logos in every piece</li>
          <li>Revision rounds defined from the start</li>
        </ul>
      </div>
    </div>

    <!-- AI photography portfolio -->
    <AiPortfolio lang="en" />

    <!-- how it works -->
    <div class="steps">
      <div class="step fx"><div class="n">01</div><h4>Brief</h4><p>You tell us about your brand, your product, and what you need to communicate.</p></div>
      <div class="step fx"><div class="n">02</div><h4>Concept</h4><p>We define style, settings, and visual direction aligned with your identity.</p></div>
      <div class="step fx"><div class="n">03</div><h4>Production</h4><p>We generate and refine every piece until it's flawless.</p></div>
      <div class="step fx"><div class="n">04</div><h4>Delivery</h4><p>You receive your files in high resolution, ready to publish.</p></div>
    </div>

    <!-- packages -->
    <div class="sec-head fx" style="margin-top:96px">
      <span class="eyebrow"><span class="bk">[</span> PACKAGES <span class="bk">]</span></span>
    </div>
    <div class="pkgs">
      <div class="pkg fx">
        <div class="pk-name">Essential</div>
        <div class="pk-tag">To start strong.</div>
        <div class="pk-desc">Consistent professional content for your brand.</div>
        <div class="pk-price">Custom quote</div>
        <ul>
          <li>Set of product images in different angles</li>
          <li>High-resolution delivery</li>
          <li>1 revision round</li>
        </ul>
        <a href="#contacto" class="btn btn-ghost">Get a quote</a>
      </div>
      <div class="pkg feat-pkg fx">
        <span class="pop">Most popular</span>
        <div class="pk-name">Professional</div>
        <div class="pk-tag">The perfect balance.</div>
        <div class="pk-desc">More volume and variety, ideal for brands active on social media.</div>
        <div class="pk-price">Custom quote</div>
        <ul>
          <li>Everything in Essential</li>
          <li>More pieces and settings</li>
          <li>Formats for multiple platforms</li>
          <li>Short video pieces</li>
          <li>2 revision rounds</li>
        </ul>
        <a href="#contacto" class="btn btn-primary">Get a quote <span class="arw">→</span></a>
      </div>
      <div class="pkg fx">
        <div class="pk-name">Premium</div>
        <div class="pk-tag">Full production.</div>
        <div class="pk-desc">Content at scale for campaigns and launches.</div>
        <div class="pk-price">Custom quote</div>
        <ul>
          <li>Everything in Professional</li>
          <li>Maximum volume of image and video</li>
          <li>Custom art direction</li>
          <li>Priority turnaround</li>
          <li>3 revision rounds</li>
        </ul>
        <a href="#contacto" class="btn btn-ghost">Get a quote</a>
      </div>
    </div>
    <p class="note fx"><b>[ note ]</b> Infographics and pieces requiring client-provided copy are quoted separately.</p>
  </div>
</section>

<!-- PORTAFOLIO -->
<section class="svc work" id="portafolio">
  <div class="wrap">
    <div class="sec-head fx"><span class="eyebrow"><span class="bk">[</span> PORTFOLIO <span class="bk">]</span></span></div>
    <h2 class="sec-title fx">Real projects,<br><span class="lime">live and working.</span></h2>
    <p class="lead fx">This is what a LOGYC website looks like in the real world. Explore it right here or visit it live.</p>
    <div class="case">
      <div class="fx">
        <div class="case-stage">
          <div class="browser">
            <div class="browser-bar"><i></i><i></i><i></i><span class="browser-url">https://<b>precisiongarage.com.co</b></span></div>
            <div class="browser-screen autoscroll" data-speed="70" tabindex="0" aria-label="Desktop view of the Precision Garage website">
              <img src="/img/portfolio/precision-garage-desktop.jpg" width="1100" height="6316" loading="lazy" alt="Desktop view of the Precision Garage website">
            </div>
          </div>
          <div class="phone">
            <div class="phone-screen autoscroll" data-speed="45" tabindex="0" aria-label="Mobile view of the Precision Garage website">
              <img src="/img/portfolio/precision-garage-mobile.jpg" width="600" height="7200" loading="lazy" alt="Mobile view of the Precision Garage website">
            </div>
          </div>
        </div>
        <div class="case-hint"><span class="dot"></span>Scroll inside the screen to explore the site</div>
      </div>
      <div class="case-info fx">
        <div class="mlabel">Web design · Bogotá</div>
        <h3>Precision Garage</h3>
        <p class="d">A Mercedes-Benz specialist shop in north Bogotá, with technicians trained by Daimler Colombia. We designed their complete website to showcase their expertise, explain every service, and turn visits into WhatsApp bookings.</p>
        <div class="chips"><span>8-page website</span><span>Interactive home</span><span>Responsive</span><span>Local SEO</span><span>Custom copy</span></div>
        <ul class="feat"><li>Interactive home page with scroll animations</li><li>A dedicated page per service: maintenance, diagnostics, and express service</li><li>Direct WhatsApp booking with a ready-to-send message</li><li>Google reviews (5.0 ★) and a work gallery to build trust</li><li>Local SEO with structured data to show up on Google</li></ul>
        <div class="case-actions">
          <a href="https://precisiongarage.com.co/" target="_blank" rel="noopener" class="btn btn-primary">View live site <span class="arw">↗</span></a>
          <a href="web-en.html" class="btn btn-ghost">View web packages</a>
        </div>
      </div>
    </div>
  </div>
</section>
<!-- /PORTAFOLIO -->

<!-- WHY -->
<section class="block why">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="eyebrow"><span class="bk">[</span> WHY LOGYC <span class="bk">]</span></span>
    </div>
    <h2 class="sec-title fx"><ScrollWordReveal client:visible parts={[{"text": "We're not a traditional agency. And that's an"}, {"text": "advantage.", "lime": true}]} /></h2>
    <WhyBento client:visible copy={{"speed": {"title": "Speed", "text": "We deliver in days what others take months to do. AI does the heavy lifting; we bring the judgment.", "tradLabel": "Traditional production", "tradValue": "weeks or months", "logycValue": "3–10 business days"}, "quality": {"title": "Quality", "text": "Every piece goes through human direction. Technology is the tool, not the shortcut.", "steps": ["AI generates", "Human direction", "Final piece"]}, "price": {"title": "Fair pricing", "text": "Lower production costs mean better prices for you — without sacrificing the result.", "cut": ["Photo shoot", "Location", "Weeks of waiting"], "result": "Better prices for you"}, "consistency": {"title": "Consistency", "text": "Content and web that speak the same visual language: your brand's.", "post": "POST", "web": "YOUR WEBSITE", "legend": "Same colors · same type · same voice"}}} />
  </div>
</section>

<!-- PROCESS -->
<section class="block proc" id="proceso">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="eyebrow"><span class="bk">[</span> HOW WE WORK <span class="bk">]</span></span>
    </div>
    <h2 class="sec-title fx">Simple, clear, and <span class="lime">straight to the point.</span></h2>
    <StackedSteps client:visible steps={[{"title": "We talk", "text": "You tell us what you need and where your brand is headed."}, {"title": "We quote", "text": "We send you a clear proposal, with defined scope and timeline."}, {"title": "We produce", "text": "We create, you review within the agreed rounds."}, {"title": "We deliver", "text": "You receive everything ready to use and go live."}]} />
  </div>
</section>

<!-- FAQ -->
<section class="block faq" id="faq">
  <div class="wrap">
    <div class="sec-head fx">
      <span class="eyebrow"><span class="bk">[</span> FREQUENTLY ASKED QUESTIONS <span class="bk">]</span></span>
    </div>
    <h2 class="sec-title fx">What everyone <span class="lime">asks.</span></h2>
    <div class="acc" id="acc">
      <div class="acc-item"><button class="acc-q">Does AI content look real? <span class="ico">+</span></button><div class="acc-a"><p>Yes. We work with the best tools on the market, and every piece goes through human direction and refinement. The goal is for it to look professional, not artificial.</p></div></div>
      <div class="acc-item"><button class="acc-q">How many revisions do I get? <span class="ico">+</span></button><div class="acc-a"><p>Each package includes a set number of revision rounds, agreed on from the start. This avoids surprises and keeps the project moving.</p></div></div>
      <div class="acc-item"><button class="acc-q">How long does a project take? <span class="ico">+</span></button><div class="acc-a"><p>It depends on scope, but we work in days, not weeks. We give you an estimated timeline in the quote.</p></div></div>
      <div class="acc-item"><button class="acc-q">Can I request just content or just the website? <span class="ico">+</span></button><div class="acc-a"><p>Of course. Each service works on its own — though they perform better together.</p></div></div>
      <div class="acc-item"><button class="acc-q">Do you work with brands outside Colombia? <span class="ico">+</span></button><div class="acc-a"><p>Yes. We work remotely and can deliver content and websites in both Spanish and English.</p></div></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta" id="contacto">
  <div class="cta-glow"></div>
  <div class="wrap">
    <span class="eyebrow fx" style="margin-bottom:26px;display:inline-flex"><span class="bk">[</span> LET'S START <span class="bk">]</span></span>
    <h2 class="fx">Ready to look<br>like the <span class="lime">future?</span></h2>
    <p class="fx">Tell us about your project and we'll send you a no-obligation quote.</p>
    <div class="cta-row fx">
      <a href="contacto-en.html" class="btn btn-primary">Start now <span class="arw">→</span></a>
      <a href="#" class="btn btn-ghost">Message us on WhatsApp</a>
    </div>
    <Instagram lang="en" variant="cta" />
  </div>
</section>
</Base>
